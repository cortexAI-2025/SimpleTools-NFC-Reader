    <string name="publisher">Publisher</string>
    <string name="about_body">SimpleTools NFC Reader is a read-only NFC reader: it never writes to chips, never clones badges and never bypasses protections. Free, no ads. Not affiliated with the brands mentioned.</string>

    <string name="info_title">NFC information</string>
    <string name="info_reads_title">What the app reads</string>
    <string name="info_reads_body">Detected technologies (NFC-A/B/F/V, ISO-DEP, MIFARE), the identifier (UID) when Android provides it, public NDEF data (text, URL, MIME) and technical information available without keys.</string>
    <string name="info_not_title">What it does not do</string>
    <string name="info_not_body">No writing to chips, no cloning, no key recovery, no access-control bypass, no automatic link opening, no data transmission.</string>
    <string name="info_animal_title">Animal chips</string>
    <string name="info_animal_body">ISO 11784/11785 animal ID chips work at 134.2 kHz. A smartphone\'s NFC works at 13.56 MHz and cannot read them directly. An external RFID reader will be needed (later version). Even with one, only the ID number is read, not the owner\'s contact details.</string>
    <string name="info_readers_title">Readers</string>
    <string name="reader_builtin">Built-in NFC</string>
    <string name="reader_bluetooth">External Bluetooth RFID reader</string>
    <string name="reader_usb">External USB-C RFID reader</string>
    <string name="reader_supported">supported</string>
    <string name="reader_planned">planned, not available in V1</string>
    <string name="info_auth_title">Product authentication</string>
    <string name="info_auth_body">A chip may contain a verification web address. The app displays it and lets you open the official service, but it can never guarantee a product is authentic.</string>


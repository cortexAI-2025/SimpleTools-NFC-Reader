    <string name="about_body">SimpleTools NFC Reader est un lecteur NFC en lecture seule : il n\'écrit jamais sur les puces, ne clone pas de badges et ne contourne aucune protection. Gratuit, sans publicité. Non affilié aux marques citées.</string>

    <!-- Informations NFC -->
    <string name="info_title">Informations NFC</string>
    <string name="info_reads_title">Ce que l\'application lit</string>
    <string name="info_reads_body">Technologies détectées (NFC-A/B/F/V, ISO-DEP, MIFARE), identifiant (UID) quand Android le fournit, données NDEF publiques (texte, URL, MIME) et informations techniques disponibles sans clé.</string>
    <string name="info_not_title">Ce qu\'elle ne fait pas</string>
    <string name="info_not_body">Aucune écriture sur les puces, aucun clonage, aucune récupération de clés, aucun contournement de contrôle d\'accès, aucune ouverture automatique de lien, aucune transmission de données.</string>
    <string name="info_animal_title">Puces animales</string>
    <string name="info_animal_body">Les puces d\'identification animale ISO 11784/11785 fonctionnent à 134,2 kHz. Le NFC d\'un smartphone fonctionne à 13,56 MHz : il ne peut pas les lire directement. Un lecteur RFID externe sera nécessaire (version ultérieure). Même avec un tel lecteur, seul le numéro d\'identification est lu, pas les coordonnées du propriétaire.</string>
    <string name="info_readers_title">Lecteurs</string>
    <string name="reader_builtin">NFC intégré</string>
    <string name="reader_bluetooth">Lecteur RFID Bluetooth externe</string>
    <string name="reader_usb">Lecteur RFID USB-C externe</string>
    <string name="reader_supported">pris en charge</string>
    <string name="reader_planned">prévu, non disponible en V1</string>
    <string name="info_auth_title">Authentification de produits</string>
    <string name="info_auth_body">Une puce peut contenir une adresse web de vérification. L\'application l\'affiche et vous propose d\'ouvrir le service officiel, mais ne peut jamais garantir l\'authenticité d\'un produit.</string>

